  "main": "dist/index.js",
  "scripts": {
    "start": "node .",
    "dev": "nodemon src/index.ts",
    "deploy": "npm run build && npm run run",
    "build": "npm run getCredentials && npm run transpile && npm run dockerBuild && npm run cleanUp",
    "transpile": "tsc -p tsconfig.build.json",
    "lint": "tslint -c tslint.json -p tsconfig.json --fix",
    "dockerBuild": "docker build -f deployment-config/Dockerfile -t jam-proxy .",
    "run": "docker run -d -p 443:443 jam-proxy",
    "getCredentials": "cp /home/jam/Desktop/source/blockchain/nodes/ethereum/mainnet/jam-sa.json src/",
    "cleanUp": "rm -r dist/ && rm src/jam-sa.json",
    "patch": "npm version patch --git-tag-version"
  },
